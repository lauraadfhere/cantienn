# Preferred: used only by Next.js server routes
BACKEND_URL=http://localhost:9050

# Server-side Parse access used by the contact API route
PARSE_APP_ID=<your-parse-app-id>
PARSE_REST_API_KEY=<your-parse-rest-api-key>

# Optional: only set when browser code must know the backend URL.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:9050

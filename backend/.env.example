# Server and site
PORT=9050
SITE_NAME=WIPPEL
SITE_URL=http://localhost:9050
SESSION_SECRET=<strong-random-session-secret>
JWT_SECRET=<strong-random-jwt-secret>

# Administrator
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<strong-admin-password>

# Parse / Back4App
PARSE_SERVER_URL=https://parseapi.back4app.com
PARSE_APP_ID=<your-parse-app-id>
PARSE_REST_KEY=<your-parse-rest-api-key>
PARSE_MASTER_KEY=<your-parse-master-key>

# Appwrite (optional alternative data provider)
APPWRITE_ENDPOINT=<your-appwrite-endpoint>
APPWRITE_PROJECT_ID=<your-appwrite-project-id>
APPWRITE_API_KEY=<your-appwrite-api-key>
APPWRITE_DATABASE_ID=<your-appwrite-database-id>
APPWRITE_ARTICLES_COLLECTION_ID=<your-appwrite-articles-collection-id>
APPWRITE_CV_COLLECTION_ID=<your-appwrite-cv-collection-id>
APPWRITE_CV_DOCUMENT_ID=<your-appwrite-cv-document-id>

# Cloudinary
CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>

# SMTP
SMTP_HOST=<your-smtp-host>
SMTP_PORT=<your-smtp-port>
SMTP_USERNAME=<your-smtp-username>
SMTP_PASSWORD=<your-smtp-password>
SMTP_FROM=<your-smtp-from-address>
SMTP_ADMIN_TO=<admin-email>

# NVIDIA API
NVAPI_KEY=<your-nvidia-api-key>
NVAPI_BASE_URL=https://integrate.api.nvidia.com/v1
NVAPI_MODEL=qwen/qwen3-coder-480b-a35b-instruct
